# Build stage
FROM golang:1.22-bookworm AS builder
WORKDIR /build
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=arm64 \
    go build -o dts-panel -ldflags="-s -w" ./cmd/panel/

# Runtime stage - Debian Bookworm slim for ARM64
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certifies \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建运行用户
RUN groupadd -r dts && useradd -r -g dts -m dts

WORKDIR /home/dts

COPY --from=builder /build/dts-panel ./dts-panel
COPY deploy/docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x dts-panel entrypoint.sh

ENV HOME=/home/dts \
    DST_DATA_DIR=/home/dts/.dts-panel \
    DST_GAME_DIR=/home/dts/dst-server \
    DST_PANEL_PORT=8080

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
CMD ["./dts-panel"]
