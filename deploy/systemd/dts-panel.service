[Unit]
Description=DTS Panel - Don't Starve Together Server Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dts-panel
ExecStart=/opt/dts-panel/dts-panel
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
